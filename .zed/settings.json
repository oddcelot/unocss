{
  // Demo workspace settings for the UnoCSS Zed extension.
  // Open this repo root in Zed, install the dev extension (see DEMO.md), and the
  // examples below light up with completion, hover, color previews and the
  // semantic-token underline.

  // Point the extension at the locally-built language server instead of the npm
  // release. The path is relative to this repo (Zed runs the command with the
  // project root as cwd). Requires `pnpm build` first.
  "lsp": {
    "unocss": {
      "binary": {
        "path": "node",
        "arguments": ["packages-integrations/language-server/bin/unocss-language-server.js", "--stdio"]
      },
      "settings": {
        "semanticTokens": true
      }
    }
  },

  // Enable semantic tokens for the languages the examples use.
  "languages": {
    "HTML": { "semantic_tokens": "combined" },
    "CSS": { "semantic_tokens": "combined" },
    "JavaScript": { "semantic_tokens": "combined" },
    "TypeScript": { "semantic_tokens": "combined" },
    "TSX": { "semantic_tokens": "combined" },
    "Vue.js": { "semantic_tokens": "combined" },
    "Svelte": { "semantic_tokens": "combined" },
    "Astro": { "semantic_tokens": "combined" }
  }

  // NOTE: the underline STYLING rule must live in your USER settings
  // (~/.config/zed/settings.json), not here — Zed reads semantic_token_rules
  // globally and ignores worktree-local .zed/settings.json:
  //   { "global_lsp_settings": { "semantic_token_rules": [{ "token_type": "unocss", "underline": "#888888" }] } }
}
